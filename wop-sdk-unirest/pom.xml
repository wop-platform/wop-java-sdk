<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.wanlianyida</groupId>
    <artifactId>wop-java-sdk</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>wop-sdk-unirest</artifactId>
  <name>WOP Java SDK :: Unirest Transport</name>
  <description>Unirest 4.x（kong.unirest.core）Transport 适配器（unirest 依赖 scope=provided，由商户自带）</description>

  <dependencies>
    <dependency>
      <groupId>com.wanlianyida</groupId>
      <artifactId>wop-sdk-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.konghq</groupId>
      <artifactId>unirest-java-core</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>mockwebserver</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- unirest-java-core 4.x 字节码 major 55（Java 11+），运行时无法在 JDK 8 加载：
       本模块 main 源码仍按根 pom release 8 参与编译门禁；JDK <11 下仅跳过测试执行。
       JDK 8 用户请改用 okhttp/jdkhttp 适配器（见 README 模块表）。 -->
  <profiles>
    <profile>
      <id>pre-java11-skip-tests</id>
      <activation>
        <jdk>(,11)</jdk>
      </activation>
      <properties>
        <maven.test.skip>true</maven.test.skip>
      </properties>
    </profile>
  </profiles>
</project>
