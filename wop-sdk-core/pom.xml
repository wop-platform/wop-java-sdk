<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.wanlianyida</groupId>
    <artifactId>wop-java-sdk</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>wop-sdk-core</artifactId>
  <name>WOP Java SDK :: Core</name>
  <description>协议核心：套件解析、canonicalRequest、x-wop-sign、x-wop-content-digest、L2 数字信封、F6 校验顺序、I7 错误模糊化（运行时依赖仅 BouncyCastle）</description>

  <properties>
    <!-- wop-specs 真源钉版（黄金向量 + interop 样本集，本仓不保留字节副本）：
         antrun 在 generate-test-resources 阶段按 commit SHA 从 raw.githubusercontent.com
         拉取并逐字节 sha256 校验，不一致即构建失败（fail-closed）。升级流程见
         CONTRIBUTING §4：先合 wop-specs PR，再以下面三项同步新钉。 -->
    <wopSpecsRef>4a50824b3b9008fbda7a6c675209ccebc713f245</wopSpecsRef>
    <wopSpecsCryptoVectorsSha256>1cbb1d3c494109d58e80cfd450c4aaf4159f991029abb875514517a232fd8001</wopSpecsCryptoVectorsSha256>
    <wopSpecsInteropCasesSha256>c920ca1a93ccb3899a659f59fed6ec4652cf9e1b3b58bbdac23c45ac3ed2353e</wopSpecsInteropCasesSha256>
  </properties>

  <dependencies>
    <!-- 唯一运行时依赖：BouncyCastle（国密 SM2/SM3/SM4） -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.18.9</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-java</artifactId>
      <version>7.20.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-junit-platform-engine</artifactId>
      <version>7.20.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-suite</artifactId>
      <version>1.12.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <testResources>
      <!-- 默认测试资源（含 features/*.feature） -->
      <testResource>
        <directory>src/test/resources</directory>
      </testResource>
      <!-- wop-specs 真源 fixture：antrun fetch-wop-specs-fixtures 拉取进 target/wop-specs，
           本仓不保留字节副本；src/test/resources 内禁止再放这两份文件（避免遮蔽真源） -->
      <testResource>
        <directory>${project.build.directory}/wop-specs</directory>
        <includes>
          <include>crypto-vectors.json</include>
          <include>interop-cases.json</include>
        </includes>
      </testResource>
    </testResources>
    <plugins>
      <!-- ===== 公共 API 兼容性门禁（japicmp，绑定 verify；CI 仅 21 档跑 verify 故生效）===== -->
      <!-- old = 入库快照 api-baseline/wop-sdk-core-api-baseline.jar（显式 API 基线，
           等价于 api-extractor 的 .api 快照），new = 当前构建产物。
           注意：不能用 GA 坐标做 old——本仓 main pom 版本长期与已发布 GA 同号
           （如 0.1.0），同 GAV 时 japicmp 会拿到 reactor 里的当前 jar 做自比对，门禁空转。
           任何公共 API 面变化（新增/删除/签名变更）都要求显式更新快照后才过 CI；
           更新流程与破坏性变更流程见 CONTRIBUTING「API 兼容性门禁」。 -->
      <plugin>
        <groupId>com.github.siom79.japicmp</groupId>
        <artifactId>japicmp-maven-plugin</artifactId>
        <version>0.26.1</version>
        <configuration>
          <oldVersion>
            <file>
              <path>${project.basedir}/api-baseline/wop-sdk-core-api-baseline.jar</path>
            </file>
          </oldVersion>
          <!-- 快照 jar 只含本模块类；其公共签名引用的 BC 类型需显式挂上老 classpath -->
          <oldClassPathDependencies>
            <dependency>
              <groupId>org.bouncycastle</groupId>
              <artifactId>bcprov-jdk18on</artifactId>
              <version>${bc.version}</version>
            </dependency>
          </oldClassPathDependencies>
          <parameter>
            <!-- 门禁契约仅覆盖公共 API；japicmp 默认 protected 会把 protected 成员变更也纳入 break，故显式收紧为 public -->
            <accessModifier>public</accessModifier>
            <!-- 任何公共 API 变化（含新增）都必须显式更新快照，防无意识漂移 -->
            <breakBuildOnModifications>true</breakBuildOnModifications>
            <!-- 兜底显式化：删除/签名变更同时构成二进制与源码不兼容 -->
            <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
            <breakBuildOnSourceIncompatibleModifications>true</breakBuildOnSourceIncompatibleModifications>
          </parameter>
        </configuration>
        <executions>
          <execution>
            <id>api-compatibility-gate</id>
            <phase>verify</phase>
            <goals>
              <goal>cmp</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- 变异测试：PIT（mvn -pl wop-sdk-core org.pitest:pitest-maven:mutationCoverage） -->
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>1.9.7</version>
        <configuration>
          <targetClasses>
            <param>com.wanlianyida.wop.*</param>
          </targetClasses>
          <targetTests>
            <param>com.wanlianyida.wop.*</param>
          </targetTests>
          <outputFormats>
            <param>HTML</param>
          </outputFormats>
          <timestampedReports>false</timestampedReports>
          <mutationThreshold>90</mutationThreshold>
          <coverageThreshold>98</coverageThreshold>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-junit5-plugin</artifactId>
            <version>1.0.0</version>
          </dependency>
        </dependencies>
      </plugin>
      <!-- ===== wop-specs 真源 fixture 拉取（引用而非副本，fail-closed）===== -->
      <!-- 按 pom 钉版（wopSpecsRef + sha256）拉取黄金向量与 interop 样本集；
           构建需可访问 raw.githubusercontent.com（wop-specs 为公开仓），
           离线/被篡改/钉版过期时在测试运行前即失败。 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>fetch-wop-specs-fixtures</id>
            <phase>generate-test-resources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <mkdir dir="${project.build.directory}/wop-specs"/>
                <get src="https://raw.githubusercontent.com/wop-platform/wop-specs/${wopSpecsRef}/crypto/crypto-vectors.json"
                     dest="${project.build.directory}/wop-specs/crypto-vectors.json.tmp" failonerror="true"/>
                <get src="https://raw.githubusercontent.com/wop-platform/wop-specs/${wopSpecsRef}/interop/v1/interop-cases.json"
                     dest="${project.build.directory}/wop-specs/interop-cases.json.tmp" failonerror="true"/>
                <checksum file="${project.build.directory}/wop-specs/crypto-vectors.json.tmp"
                          algorithm="SHA-256" property="wopSpecsFetchedCrypto"/>
                <checksum file="${project.build.directory}/wop-specs/interop-cases.json.tmp"
                          algorithm="SHA-256" property="wopSpecsFetchedInterop"/>
                <condition property="wopSpecsCryptoMismatch">
                  <not>
                    <equals arg1="${wopSpecsFetchedCrypto}" arg2="${wopSpecsCryptoVectorsSha256}" casesensitive="false"/>
                  </not>
                </condition>
                <condition property="wopSpecsInteropMismatch">
                  <not>
                    <equals arg1="${wopSpecsFetchedInterop}" arg2="${wopSpecsInteropCasesSha256}" casesensitive="false"/>
                  </not>
                </condition>
                <fail if="wopSpecsCryptoMismatch"
                      message="wop-specs crypto-vectors.json sha256 mismatch（期望 ${wopSpecsCryptoVectorsSha256}，实得 ${wopSpecsFetchedCrypto}）：向量变更须先合 wop-specs PR；真源升级后以新 commit SHA 与新 sha256 同步更新 wop-sdk-core/pom.xml 的 wopSpecsRef / wopSpecsCryptoVectorsSha256（见 CONTRIBUTING §4）。"/>
                <fail if="wopSpecsInteropMismatch"
                      message="wop-specs interop-cases.json sha256 mismatch（期望 ${wopSpecsInteropCasesSha256}，实得 ${wopSpecsFetchedInterop}）：样本集升级须六仓协同；升级后同步更新 wop-sdk-core/pom.xml 的 wopSpecsInteropCasesSha256 与 InteropConformanceTest 哨兵（FIXTURE_SHA256 / KNOWN_IDS）。"/>
                <move file="${project.build.directory}/wop-specs/crypto-vectors.json.tmp"
                      tofile="${project.build.directory}/wop-specs/crypto-vectors.json" overwrite="true"/>
                <move file="${project.build.directory}/wop-specs/interop-cases.json.tmp"
                      tofile="${project.build.directory}/wop-specs/interop-cases.json" overwrite="true"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
